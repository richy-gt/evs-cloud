# Configuracion de Entorno para Kafka Tutorial (Local y Azure VM)

# IP o Host para advertised listeners de Kafka:
# - En Local o ejecucion interna en la VM de Azure: usa 'localhost'
# - Si te vas a conectar al broker Kafka desde tu laptop hacia la VM de Azure: coloca la IP publica o DNS de la VM de Azure
KAFKA_HOST=localhost

# Puerto para la interfaz web de Kafka UI:
# - 8085 por defecto para no chocar con el puerto 8080 de Pedidos360
KAFKA_UI_PORT=8085

# Puerto para la API de Spring Boot Kafka Tutorial:
KAFKA_APP_PORT=8888
